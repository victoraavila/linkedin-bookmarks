<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.linkedinbookmarks.sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PROJECT__/.venv/bin/lbm</string>
        <string>sync</string>
        <string>--mode</string>
        <string>quick</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__PROJECT__</string>
    <key>StartInterval</key>
    <integer>21600</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>__PROJECT__/data/sync.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT__/data/sync.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>LB_DATA_DIR</key>
        <string>__PROJECT__/data</string>
    </dict>
</dict>
</plist>
